# ==============================================================================
# ElderCare Frontend Environment Configuration (.env.example)
# ==============================================================================

# Backend API URL (for Vercel deployment)
# Local development: leave empty to use Vite local proxy (/api -> http://localhost:5001)
# Production (Vercel): https://elderly-care-dashboard-7qo1.onrender.com
VITE_API_URL=https://elderly-care-dashboard-7qo1.onrender.com

# Google OAuth 2.0 Client ID (Public Web Client ID)
# Keep Client Secret strictly on backend!
# In Google Cloud Console:
# - Authorized JavaScript origins: http://localhost:5173, https://your-vercel-domain.vercel.app
# - Authorized redirect URIs: http://localhost:5173, https://your-vercel-domain.vercel.app
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ==============================================================================
# ElderCare System Environment Configuration Template (.env.example)
# Copy this file to .env and fill in your actual local credentials.
# Never commit real credentials or secrets to version control.
# ==============================================================================

# Backend Server Port
PORT=5001

# MySQL Database Connection Settings
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=eldercare_db
DB_PORT=3306

# JSON Web Token (JWT) Authentication
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# Google OAuth 2.0 Web Client Configuration
# Obtain your Client ID and Client Secret from: https://console.cloud.google.com/apis/credentials
# Authorized JavaScript Origins: http://localhost:5173, http://127.0.0.1:5173
# Authorized Redirect URIs: http://localhost:5173, http://127.0.0.1:5173, http://localhost:5001/api/auth/google/callback

# Frontend Client ID (Public / Safe for browser exposure)
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Backend Client Credentials (Keep secret! Never expose to client)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret_here

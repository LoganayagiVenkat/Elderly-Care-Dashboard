# ==============================================================================
# ElderCare Backend Environment Configuration (.env.example)
# ==============================================================================

# Server Port (Render sets PORT automatically)
PORT=5001
NODE_ENV=production

# ------------------------------------------------------------------------------
# Production MySQL Database Configuration (Render Environment Variables)
# Option A: Individual Variables
# ------------------------------------------------------------------------------
DB_HOST=your_cloud_mysql_host.example.com
DB_USER=your_mysql_username
DB_PASSWORD=your_mysql_password
DB_NAME=eldercare_db
DB_PORT=3306
DB_SSL=true

# Option B: Connection String (Aiven, TiDB, Railway, PlanetScale, etc.)
# DATABASE_URL=mysql://user:password@host:port/dbname?ssl=true

# ------------------------------------------------------------------------------
# Frontend & CORS Configuration
# ------------------------------------------------------------------------------
# Your deployed Vercel frontend URL (comma-separated if multiple)
FRONTEND_URL=https://your-eldercare-app.vercel.app

# ------------------------------------------------------------------------------
# Authentication (JWT)
# ------------------------------------------------------------------------------
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# ------------------------------------------------------------------------------
# Google OAuth 2.0 Credentials (Backend Only - NEVER commit secrets)
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret_here
